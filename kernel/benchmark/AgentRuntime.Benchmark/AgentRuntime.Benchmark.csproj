<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentRuntime.Benchmark</RootNamespace>
    <AssemblyName>AgentRuntime.Benchmark</AssemblyName>
    <!-- 尺子：独立实验系统。
         方向铁则 —— Benchmark → Runtime 单向引用；Runtime 永不引用 Benchmark。 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentRuntime.Core\AgentRuntime.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentRuntime.Models\AgentRuntime.Models.csproj" />
    <ProjectReference Include="..\..\src\AgentRuntime.Modules\AgentRuntime.Modules.csproj" />
    <ProjectReference Include="..\..\src\AgentRuntime.Providers\AgentRuntime.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="benchmark.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
