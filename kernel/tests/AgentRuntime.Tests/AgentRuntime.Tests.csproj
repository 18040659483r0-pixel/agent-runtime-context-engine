<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>AgentRuntime.Tests</RootNamespace>
    <!-- xUnit v3：测试工程是可执行程序（自运行 runner） -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentRuntime.Core\AgentRuntime.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentRuntime.Models\AgentRuntime.Models.csproj" />
    <ProjectReference Include="..\..\src\AgentRuntime.Modules\AgentRuntime.Modules.csproj" />
    <ProjectReference Include="..\..\src\AgentRuntime.Providers\AgentRuntime.Providers.csproj" />
    <!-- 组合根也进测试：tail 四条命令的**命令行**那一层必须有可执行的不变量测试（I17），不能只靠手跑。 -->
    <ProjectReference Include="..\..\src\AgentRuntime.Cli\AgentRuntime.Cli.csproj" />
    <!-- TUI 宿主也进测试：T1/T2/T3/T6 不变量必须能在面板这一层断言（而不是只靠手跑）。 -->
    <ProjectReference Include="..\..\src\AgentRuntime.Tui\AgentRuntime.Tui.csproj" />
  </ItemGroup>

</Project>
