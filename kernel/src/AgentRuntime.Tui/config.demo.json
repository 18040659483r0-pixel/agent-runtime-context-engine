{
  // 零成本演示配置：配 tools/mock-provider（127.0.0.1:8899）端到端跑通。
  // 路径一律相对**本文件所在目录**解析；演示产物落在 .demo/（可再生，不入库）。
  "provider": "openai-compatible",
  "baseUrl": "http://127.0.0.1:8899/v1",
  "model": "mock-model",
  "apiKeyEnv": "AGENTRUNTIME_MOCK_API_KEY",
  "timeoutSeconds": 30,
  "temperature": null,

  // ⚠️ 模块次序 = prompt 贡献次序，必须满足第三道闸门：冻结区 → R2 → R4 → R5 → R3（R3 居末）。
  "modules": ["system-rules", "rules", "knowledge", "memory-index", "append-stream", "current-tail", "dynamic-draft", "focus"],
  "systemRules": "演示用铁则：回答尽量短，先给结论再给依据。",
  "sessionMaxTurns": 0,

  "frozen": { "root": "../../frozen", "watermark": "./.demo/watermark.json", "domains": [], "project": "" },

  "stream": { "path": "./.demo/stream.jsonl", "maxEvents": 0 },
  "snapshot": { "path": "./.demo/snapshot.json" },
  "focus": { "path": "./.demo/focus.json" },
  "currentTail": { "storePath": "./.demo/tail" },
  "dynamicDraft": { "storePath": "./.demo/draft" }
}
