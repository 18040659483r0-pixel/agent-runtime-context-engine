<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentRuntime.Hosting</RootNamespace>
    <AssemblyName>AgentRuntime.Hosting</AssemblyName>
    <!-- 宿主共用层（组合根）：把「配置 → 模块 → 客户端 → 引擎」的装配与只读面板渲染
         收在一处，供多个宿主（Cli / Tui）复用 —— 内核（Core）与模块（Modules）都不认识它。 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentRuntime.Core\AgentRuntime.Core.csproj" />
    <ProjectReference Include="..\AgentRuntime.Models\AgentRuntime.Models.csproj" />
    <ProjectReference Include="..\AgentRuntime.Modules\AgentRuntime.Modules.csproj" />
    <ProjectReference Include="..\AgentRuntime.Providers\AgentRuntime.Providers.csproj" />
    <!-- 呈现层（角色 / 样式 / 字节三分）：宿主面板只说角色（`[[done]]…[[/]]`），
         颜色只在 Presentation 那一处声明 —— Core 不认识它，方向永远是 宿主 → 呈现。 -->
    <ProjectReference Include="..\AgentRuntime.Presentation\AgentRuntime.Presentation.csproj" />
    <!-- 呈现层：面板行带角色标记（[[done]]…[[/]]）穿过字符串通道 —— 方向是 宿主 → 呈现层，
         呈现层自己零 AgentRuntime 依赖（有单测钉住）。 -->
    <ProjectReference Include="..\AgentRuntime.Presentation\AgentRuntime.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentRuntime.Tests" />
    <InternalsVisibleTo Include="AgentRuntime.Tui" />
  </ItemGroup>

</Project>
