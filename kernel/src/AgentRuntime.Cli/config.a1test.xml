<?xml version="1.0" encoding="utf-8"?>
<RuntimeConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Provider>openai-compatible</Provider>
  <BaseUrl>https://api.deepseek.com</BaseUrl>
  <Model>deepseek-v4-flash</Model>
  <ApiKeyEnv>AGENTRUNTIME_API_KEY</ApiKeyEnv>
  <ApiKeyFile>~/.agentruntime/api_key</ApiKeyFile>
  <TimeoutSeconds>1200</TimeoutSeconds>
  <Temperature xsi:nil="true" />
  <Modules>
    <string>rules</string>
    <string>knowledge</string>
    <string>memory-index</string>
    <string>append-stream</string>
    <string>tool</string>
    <string>worker-dispatch</string>
    <string>current-tail</string>
    <string>dynamic-draft</string>
    <string>focus</string>
  </Modules>
  <SystemRules />
  <SessionMaxTurns>0</SessionMaxTurns>
  <ContextWindow>0</ContextWindow>
  <Frozen>
    <Root>../../frozen</Root>
    <Domains />
    <Project />
  </Frozen>
  <Stream>
    <Path />
    <MaxEvents>0</MaxEvents>
  </Stream>
  <Lifecycle>
    <Window>closeout</Window>
    <Pipeline />
    <NativeCloseout>false</NativeCloseout>
  </Lifecycle>
  <Snapshot>
    <Enabled>true</Enabled>
  </Snapshot>
  <Focus>
    <Policy>report</Policy>
    <TopK>16</TopK>
    <MinWeight>0.95</MinWeight>
    <HalfLifeTurns>40</HalfLifeTurns>
  </Focus>
  <CurrentTail />
  <DynamicDraft />
  <ToolQueue />
  <L3>
    <Repo>../../whitebox/workspace/knowledge/.derived/l3.xml</Repo>
  </L3>
  <Worker>
    <Enabled>true</Enabled>
    <ProviderName />
    <Provider>
      <BaseUrl>https://api.deepinfra.com/v1/openai</BaseUrl>
      <Model>deepseek-ai/DeepSeek-V4-Flash-0731</Model>
      <ApiKeyEnv>AGENTRUNTIME_WORKER_API_KEY</ApiKeyEnv>
      <ApiKeyFile>~/.agentruntime/deepinfra_worker_key</ApiKeyFile>
      <TimeoutSeconds>90</TimeoutSeconds>
      <ServiceTier />
    </Provider>
    <Tools>
      <string>read</string>
      <string>list</string>
      <string>write</string>
      <string>edit</string>
    </Tools>
    <MaxTurns>8</MaxTurns>
    <MaxPromptTokens>4000</MaxPromptTokens>
    <Home>../../whitebox/workspace/worker</Home>
    <MaxDispatchesPerReply>2</MaxDispatchesPerReply>
    <MaxWorkers>2</MaxWorkers>
    <BulkTokens>500</BulkTokens>
    <BulkCumulativeTokens>6000</BulkCumulativeTokens>
    <Pace>
      <Enabled>false</Enabled>
      <KMedian>3</KMedian>
      <ConstantTokens>30000</ConstantTokens>
      <GateSeconds>0</GateSeconds>
      <MinSeconds>100</MinSeconds>
      <MaxSeconds>1200</MaxSeconds>
      <HardBelowTokPerSec>15</HardBelowTokPerSec>
      <CeilingMode>max</CeilingMode>
      <MinSamples>20</MinSamples>
      <FallbackPrefillTokPerSec>8000</FallbackPrefillTokPerSec>
      <FallbackDecodeTokPerSec>25</FallbackDecodeTokPerSec>
      <FallbackOverheadSeconds>3</FallbackOverheadSeconds>
    </Pace>
  </Worker>
</RuntimeConfiguration>