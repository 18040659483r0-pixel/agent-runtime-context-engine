<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentRuntime.Cli</RootNamespace>
    <AssemblyName>AgentRuntime.Cli</AssemblyName>
    <!-- 组合根：全项目里唯一 new 具体实现的地方 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentRuntime.Core\AgentRuntime.Core.csproj" />
    <ProjectReference Include="..\AgentRuntime.Models\AgentRuntime.Models.csproj" />
    <ProjectReference Include="..\AgentRuntime.Modules\AgentRuntime.Modules.csproj" />
    <ProjectReference Include="..\AgentRuntime.Providers\AgentRuntime.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.mock.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
