{
  "_comment": "私有冻结语料配置（A 档）：frozen.root 指向由 tools/frozen-build 生成的 frozen-private/。本文件只含路径，不含任何密钥。",
  "provider": "openai-compatible",
  "baseUrl": "https://api.deepseek.com",
  "model": "deepseek-v4-flash",
  "apiKeyEnv": "AGENTRUNTIME_API_KEY",
  "apiKeyFile": "~/.agentruntime/api_key",
  "timeoutSeconds": 180,
  "temperature": null,
  "modules": [
    "rules",
    "knowledge",
    "memory-index",
    "append-stream"
  ],
  "systemRules": "",
  "sessionMaxTurns": 0,
  "frozen": {
    "root": "../../frozen-private",
    "domains": [],
    "project": ""
  },
  "stream": {
    "path": "~/.agentruntime/stream.jsonl",
    "maxEvents": 0
  },
  "snapshot": {
    "path": "~/.agentruntime/snapshot.json",
    "enabled": true
  }
}
