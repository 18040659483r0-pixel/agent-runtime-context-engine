<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CloseoutTool</RootNamespace>
    <AssemblyName>Closeout</AssemblyName>
    <!-- **[WB] 收尾流水线工具**（`tools/closeout.py` 的 C# 替身 · A1）。
         位置说明：它是**工具**不是运行时 ⇒ 住在 `tools/`，不住 `src/`。
         依据：**R2 铁则**（`docs/RULES-RUNTIME.md`）—— 运行时（`src/`）唯一能起进程的地方是工具面 `ExecTool`；
         本工具要起 `svn` 与调 CLI 闸门 ⇒ 归 `tools/`，与其原身 `tools/closeout.py` 同址。
         零外部依赖；只引 `AgentRuntime.Core` 拿强类型 XML 出口（`DataContractXml`，与 `tail/default.xml` 同一族）。
         方向：tools → src（单向，不受 R2 限制）。 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentRuntime.Core\AgentRuntime.Core.csproj" />
  </ItemGroup>

</Project>
